# Không bắt buộc khi deploy lên Firebase Hosting: ứng dụng tự đọc cấu hình từ /__/firebase/init.json.
# Chỉ cần khi chạy "npm run dev" trên máy và muốn nối vào một dự án Firebase thật:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Email liên hệ hiển thị ở chân trang và chính sách bảo mật (để trống thì không hiện)
VITE_CONTACT_EMAIL=
# Chạy trên máy với Firebase Emulator (không cần dự án thật): VITE_USE_EMULATORS=1 rồi "npx firebase emulators:start --only auth,firestore --project demo-nepnha"
VITE_USE_EMULATORS=
