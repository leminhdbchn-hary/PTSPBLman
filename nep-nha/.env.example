# Sao chép thành .env.local rồi điền giá trị lấy ở Supabase → Project Settings → API.
# Chỉ dùng khoá "anon/publishable" ở đây. KHÔNG bao giờ đưa service-role key vào dự án này.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Địa chỉ công khai của website (dùng cho liên kết trong email xác minh, đặt lại mật khẩu và lời mời)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email liên hệ hiển thị ở chân trang và trang chính sách
NEXT_PUBLIC_CONTACT_EMAIL=lienhe@example.com
