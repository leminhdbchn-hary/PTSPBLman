// TỆP SINH TỰ ĐỘNG bởi scripts/combine-rules.mjs — đừng sửa tay.
rules_version = '2';
// ============================================================================================
// Memo — luật bảo mật Firestore.
// Nguyên tắc: mặc định TỪ CHỐI. Mọi dữ liệu gia đình nằm dưới nn_families/{fid}; chỉ người có
// tài liệu thành viên nn_families/{fid}/members/{uid} mới đọc được, và quyền ghi theo vai trò:
//   owner (chủ sở hữu) > admin (quản trị) > contributor (đóng góp) > viewer (chỉ xem).
// Ký ức có 3 mức hiển thị: family (cả nhà), admins (quản trị), private (chỉ người viết — kể cả
// chủ sở hữu cũng không đọc được).
// Các truy vấn danh sách phải kèm điều kiện khớp luật (ví dụ where visibility == 'family'),
// vì Firestore không lọc hộ: truy vấn nào có thể trả về tài liệu không được phép sẽ bị từ chối cả.
// ============================================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- hàm dùng chung ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function famPath(fid) { return /databases/$(database)/documents/nn_families/$(fid); }
    function memberPath(fid, uid) { return /databases/$(database)/documents/nn_families/$(fid)/members/$(uid); }
    function memoryPath(fid, mid) { return /databases/$(database)/documents/nn_families/$(fid)/memories/$(mid); }
    function personPath(fid, pid) { return /databases/$(database)/documents/nn_families/$(fid)/people/$(pid); }
    function storyPath(fid, sid) { return /databases/$(database)/documents/nn_families/$(fid)/stories/$(sid); }
    function invitePath(fid, h) { return /databases/$(database)/documents/nn_families/$(fid)/invites/$(h); }

    function isMember(fid) { return signedIn() && exists(memberPath(fid, me())); }
    function myRole(fid) { return get(memberPath(fid, me())).data.role; }
    function canWrite(fid) { return isMember(fid) && myRole(fid) in ['owner', 'admin', 'contributor']; }
    function isAdmin(fid) { return isMember(fid) && myRole(fid) in ['owner', 'admin']; }
    function isOwner(fid) { return isMember(fid) && myRole(fid) == 'owner'; }
    // Chủ sở hữu đang xoá cả gia đình (đã đặt closing = true, không thể huỷ): được phép XOÁ mọi tài liệu
    // con (kể cả ký ức riêng tư của người khác) để dọn sạch, nhưng vẫn KHÔNG được đọc chúng.
    function closingByOwner(fid) {
      return signedIn() && get(famPath(fid)).data.get('closing', false) == true && get(famPath(fid)).data.ownerId == me();
    }
    function canReadMemory(fid, m) {
      return isMember(fid) && (m.visibility == 'family' || m.createdBy == me() || (m.visibility == 'admins' && isAdmin(fid)));
    }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(v, max) { return v == null || (v is string && v.size() <= max); }
    function optDate(v) { return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }

    // ---------- hồ sơ tài khoản ----------
    match /nn_users/{userId} {
      allow read, delete: if signedIn() && userId == me();
      allow create, update: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['fullName', 'bio', 'email', 'createdAt', 'updatedAt'])
        && str(request.resource.data.fullName, 1, 100) && optStr(request.resource.data.get('bio', null), 1000);
    }

    // Tìm các gia đình của tôi: collectionGroup('members').where('uid', '==', uid)
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == me();
    }

    // ---------- gia đình ----------
    match /nn_families/{fid} {
      function validFamily(d) {
        return str(d.name, 1, 80) && optStr(d.get('description', null), 500);
      }
      allow get: if isMember(fid);
      allow list: if false;
      // Tạo gia đình: cùng một batch với tài liệu thành viên "owner" của chính mình
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'description', 'ownerId', 'createdAt', 'closing'])
        && validFamily(request.resource.data)
        && request.resource.data.ownerId == me()
        && request.resource.data.closing == false
        && getAfter(memberPath(fid, me())).data.role == 'owner';
      allow update: if
        // sửa tên/mô tả: quản trị viên
        (isAdmin(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description'])
          && validFamily(request.resource.data) && resource.data.closing == false)
        // chuyển quyền chủ sở hữu: cùng batch người nhận được đặt role 'owner'
        || (isOwner(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])
          && request.resource.data.ownerId != me()
          && getAfter(memberPath(fid, request.resource.data.ownerId)).data.role == 'owner')
        // bắt đầu xoá gia đình (một chiều, không bật lại được)
        || (isOwner(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closing'])
          && request.resource.data.closing == true);
      allow delete: if signedIn() && resource.data.closing == true && resource.data.ownerId == me();

      // ---------- thành viên ----------
      match /members/{memberId} {
        function inviteOk(h) {
          let inv = get(invitePath(fid, h)).data;
          return inv.acceptedBy == null && inv.revoked == false && inv.expiresAt > request.time
            && (inv.email == null || (request.auth.token.email != null && inv.email == request.auth.token.email.lower()))
            && request.resource.data.role == inv.role
            && getAfter(invitePath(fid, h)).data.acceptedBy == me();
        }
        allow read: if isMember(fid);
        allow create: if signedIn() && memberId == me()
          && request.resource.data.keys().hasOnly(['uid', 'role', 'name', 'joinedAt', 'invite'])
          && request.resource.data.uid == me() && str(request.resource.data.name, 1, 100)
          && (
            // người tạo gia đình
            (request.resource.data.role == 'owner' && !exists(famPath(fid)) && getAfter(famPath(fid)).data.ownerId == me())
            // nhận lời mời hợp lệ (một lần, còn hạn, chưa thu hồi, đúng email nếu có)
            || (request.resource.data.invite is string && inviteOk(request.resource.data.invite))
          );
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'name'])
          && request.resource.data.uid == resource.data.uid
          && (
            // đổi tên hiển thị của chính mình
            (memberId == me() && request.resource.data.role == resource.data.role && str(request.resource.data.name, 1, 100))
            // chủ sở hữu đổi vai trò người khác
            || (isOwner(fid) && memberId != me() && resource.data.role != 'owner' && request.resource.data.role in ['admin', 'contributor', 'viewer'])
            // quản trị viên đổi giữa đóng góp / chỉ xem
            || (isMember(fid) && myRole(fid) == 'admin' && resource.data.role in ['contributor', 'viewer'] && request.resource.data.role in ['contributor', 'viewer'])
            // chuyển quyền chủ sở hữu (batch): người nhận
            || (isOwner(fid) && get(famPath(fid)).data.ownerId == me() && getAfter(famPath(fid)).data.ownerId == memberId && request.resource.data.role == 'owner')
            // chuyển quyền chủ sở hữu (batch): chủ cũ thành quản trị viên
            || (memberId == me() && resource.data.role == 'owner' && request.resource.data.role == 'admin'
                && get(famPath(fid)).data.ownerId == me() && getAfter(famPath(fid)).data.ownerId != me())
          );
        allow delete: if (signedIn() && memberId == me() && resource.data.role != 'owner')           // tự rời
          || (isOwner(fid) && resource.data.role != 'owner')                                         // chủ mời ra
          || (isMember(fid) && myRole(fid) == 'admin' && resource.data.role in ['contributor', 'viewer'])
          || closingByOwner(fid);                                                                    // xoá gia đình
      }

      // ---------- lời mời (id = SHA-256 của mã trong liên kết; mã gốc không lưu) ----------
      match /invites/{h} {
        // Ai có liên kết mới tính được h, nên cho đọc đúng một tài liệu để xem trước tên gia đình
        allow get: if true;
        allow list: if isAdmin(fid);
        allow create: if isAdmin(fid) && h.size() == 64
          && request.resource.data.keys().hasOnly(['familyId', 'familyName', 'role', 'email', 'createdBy', 'createdAt', 'expiresAt', 'acceptedBy', 'acceptedAt', 'revoked'])
          && request.resource.data.familyId == fid && str(request.resource.data.familyName, 1, 80)
          && (request.resource.data.role in ['contributor', 'viewer'] || (request.resource.data.role == 'admin' && isOwner(fid)))
          && (request.resource.data.email == null || str(request.resource.data.email, 3, 254))
          && request.resource.data.createdBy == me()
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(31, 'd')
          && request.resource.data.acceptedBy == null && request.resource.data.acceptedAt == null
          && request.resource.data.revoked == false;
        allow update: if
          // thu hồi
          (isAdmin(fid) && resource.data.acceptedBy == null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
            && request.resource.data.revoked == true)
          // nhận lời mời: cùng batch tạo tài liệu thành viên trỏ về lời mời này
          || (signedIn() && resource.data.acceptedBy == null && resource.data.revoked == false && resource.data.expiresAt > request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy', 'acceptedAt'])
            && request.resource.data.acceptedBy == me()
            && getAfter(memberPath(fid, me())).data.invite == h);
        allow delete: if closingByOwner(fid);
      }

      // ---------- ký ức ----------
      match /memories/{mid} {
        function validMemory(d) {
          return d.keys().hasOnly(['title', 'body', 'happenedOn', 'location', 'tags', 'visibility', 'personIds', 'photoIds',
                                   'cover', 'demoImages', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'isDemo'])
            && str(d.title, 1, 140) && d.body is string && d.body.size() <= 10000
            && optDate(d.happenedOn) && optStr(d.location, 120)
            && d.tags is list && d.tags.size() <= 8
            && d.visibility in ['family', 'admins', 'private']
            && d.personIds is list && d.personIds.size() <= 30
            && d.photoIds is list && d.photoIds.size() <= 12
            && (d.cover == null || (d.cover is string && d.cover.size() < 150000))
            && d.demoImages is list && d.demoImages.size() <= 4
            && d.isDemo is bool && str(d.createdByName, 1, 100);
        }
        function canModify() {
          return (canWrite(fid) && resource.data.createdBy == me()) || (isAdmin(fid) && resource.data.visibility != 'private');
        }
        allow read: if canReadMemory(fid, resource.data);
        allow create: if canWrite(fid) && validMemory(request.resource.data) && request.resource.data.createdBy == me();
        allow update: if canModify() && validMemory(request.resource.data) && unchanged(['createdBy', 'createdAt', 'isDemo'])
          // quản trị viên sửa ký ức của người khác thì không được đổi chế độ hiển thị
          && (resource.data.createdBy == me() || request.resource.data.visibility == resource.data.visibility);
        // xoá: người viết luôn xoá được ký ức của mình (kể cả khi đã bị hạ xuống chỉ-xem, ví dụ lúc rời gia đình)
        allow delete: if (isMember(fid) && resource.data.createdBy == me()) || canModify() || closingByOwner(fid);

        match /comments/{cid} {
          allow read: if canReadMemory(fid, get(memoryPath(fid, mid)).data);
          allow create: if canReadMemory(fid, get(memoryPath(fid, mid)).data)
            && request.resource.data.keys().hasOnly(['body', 'authorId', 'authorName', 'createdAt'])
            && request.resource.data.authorId == me() && str(request.resource.data.body, 1, 2000) && str(request.resource.data.authorName, 1, 100);
          allow delete: if (signedIn() && resource.data.authorId == me())
            || closingByOwner(fid)
            || (isAdmin(fid) && canReadMemory(fid, get(memoryPath(fid, mid)).data));
        }
      }

      // ---------- ảnh (mỗi ảnh một tài liệu, dữ liệu ảnh JPEG đã nén dạng data URL) ----------
      // Đọc từng ảnh theo id; quyền xem đi theo ký ức chứa nó.
      match /photos/{pid} {
        allow get: if isMember(fid) && canReadMemory(fid, get(memoryPath(fid, resource.data.memoryId)).data);
        allow list: if false;
        allow create: if canWrite(fid)
          && request.resource.data.keys().hasOnly(['memoryId', 'data', 'w', 'h', 'createdBy', 'createdAt'])
          && request.resource.data.createdBy == me()
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000
          && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
          && (getAfter(memoryPath(fid, request.resource.data.memoryId)).data.createdBy == me()
              || (isAdmin(fid) && getAfter(memoryPath(fid, request.resource.data.memoryId)).data.visibility != 'private'));
        allow update: if false;
        allow delete: if (signedIn() && resource.data.createdBy == me()) || isAdmin(fid) || closingByOwner(fid);
      }

      // ---------- lời kể (ghi âm) ----------
      // Thông tin lời kể (nhẹ, dùng để liệt kê) và âm thanh (nặng) nằm ở hai nơi để danh sách tải nhanh.
      match /stories/{sid} {
        function validStory(d) {
          return d.keys().hasOnly(['title', 'personId', 'personName', 'seconds', 'mime', 'createdBy', 'createdByName', 'createdAt'])
            && str(d.title, 1, 140) && optStr(d.personId, 64) && str(d.personName, 1, 100)
            && d.seconds is int && d.seconds >= 1 && d.seconds <= 300
            && d.mime is string && d.mime.matches('^audio/[a-z0-9.+-]+$');
        }
        allow read: if isMember(fid);
        allow create: if canWrite(fid) && validStory(request.resource.data) && request.resource.data.createdBy == me()
          && str(request.resource.data.createdByName, 1, 100);
        allow update: if false;
        allow delete: if (signedIn() && resource.data.createdBy == me()) || isAdmin(fid) || closingByOwner(fid);
      }
      match /storyAudio/{sid} {
        allow get: if isMember(fid);
        allow list: if false;
        allow create: if canWrite(fid)
          && request.resource.data.keys().hasOnly(['data', 'createdBy'])
          && request.resource.data.createdBy == me()
          && request.resource.data.data is string && request.resource.data.data.size() < 950000
          && request.resource.data.data.matches('^data:audio/[a-z0-9.+-]+(;codecs=[A-Za-z0-9.,-]+)?;base64,[A-Za-z0-9+/=]+$')
          && getAfter(storyPath(fid, sid)).data.createdBy == me();
        allow update: if false;
        allow delete: if (signedIn() && resource.data.createdBy == me()) || isAdmin(fid) || closingByOwner(fid);
      }

      // ---------- sổ đăng ký id (chỉ chứa đường dẫn, không chứa nội dung) ----------
      // Để chủ sở hữu dọn sạch khi xoá gia đình, kể cả ký ức riêng tư mà họ không được đọc.
      match /registry/{rid} {
        allow read: if isOwner(fid) || closingByOwner(fid) || (signedIn() && resource.data.createdBy == me());
        allow create: if isMember(fid)
          && request.resource.data.keys().hasOnly(['kind', 'path', 'createdBy'])
          && request.resource.data.kind in ['memory', 'photo', 'comment', 'story', 'audio']
          && request.resource.data.createdBy == me()
          && request.resource.data.path is string && request.resource.data.path.size() < 300
          && request.resource.data.path.matches('^nn_families/' + fid + '/(memories|photos|stories|storyAudio)/[A-Za-z0-9_-]+(/comments/[A-Za-z0-9_-]+)?$');
        allow delete: if (signedIn() && resource.data.createdBy == me()) || isOwner(fid) || closingByOwner(fid);
      }

      // ---------- hồ sơ thành viên (người thân, có thể chưa có tài khoản) ----------
      match /people/{pid} {
        function validPerson(d) {
          return d.keys().hasOnly(['fullName', 'relationLabel', 'birthDate', 'birthDateVisible', 'bio', 'avatar', 'userId', 'isDemo', 'createdBy', 'createdAt', 'updatedAt'])
            && str(d.fullName, 1, 100) && optStr(d.relationLabel, 40) && optStr(d.bio, 3000)
            && optDate(d.birthDate) && d.birthDateVisible is bool
            // ngày sinh để riêng tư thì KHÔNG nằm ở đây mà ở peoplePrivate
            && (d.birthDateVisible == true || d.birthDate == null)
            && (d.avatar == null || (d.avatar is string && d.avatar.size() < 150000 && d.avatar.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')))
            && d.isDemo is bool;
        }
        allow read: if isMember(fid);
        allow create: if isMember(fid) && validPerson(request.resource.data) && request.resource.data.createdBy == me()
          && (canWrite(fid) || request.resource.data.userId == me());
        allow update: if isMember(fid) && validPerson(request.resource.data) && unchanged(['createdBy', 'createdAt', 'userId', 'isDemo'])
          && (isAdmin(fid) || (canWrite(fid) && resource.data.createdBy == me()) || resource.data.userId == me());
        allow delete: if isAdmin(fid) || (canWrite(fid) && resource.data.createdBy == me()) || closingByOwner(fid);
      }
      // Ngày sinh riêng tư: chỉ quản trị viên, người tạo hồ sơ và chính người đó đọc được
      match /peoplePrivate/{pid} {
        function allowed(p) { return isAdmin(fid) || (canWrite(fid) && p.createdBy == me()) || p.userId == me(); }
        allow read: if isMember(fid) && allowed(get(personPath(fid, pid)).data);
        allow create, update: if isMember(fid) && allowed(getAfter(personPath(fid, pid)).data)
          && request.resource.data.keys().hasOnly(['birthDate']) && optDate(request.resource.data.birthDate);
        allow delete: if (isMember(fid) && (isAdmin(fid) || !exists(personPath(fid, pid)) || allowed(get(personPath(fid, pid)).data))) || closingByOwner(fid);
      }

      // ---------- quan hệ gia phả ----------
      match /relationships/{rid} {
        allow read: if isMember(fid);
        allow create: if canWrite(fid)
          && request.resource.data.keys().hasOnly(['a', 'b', 'kind', 'createdBy', 'createdAt', 'isDemo'])
          && request.resource.data.kind in ['parent', 'spouse']
          && request.resource.data.a is string && request.resource.data.b is string
          && request.resource.data.a != request.resource.data.b
          && rid == request.resource.data.kind + '_' + request.resource.data.a + '_' + request.resource.data.b
          && (request.resource.data.kind == 'parent' || request.resource.data.a < request.resource.data.b)
          && exists(personPath(fid, request.resource.data.a)) && exists(personPath(fid, request.resource.data.b))
          && request.resource.data.createdBy == me() && request.resource.data.isDemo is bool;
        allow update: if false;
        allow delete: if isAdmin(fid) || (canWrite(fid) && resource.data.createdBy == me()) || closingByOwner(fid);
      }
    }

    // ===== Luật của site Phòng PTSPBL (giữ nguyên, chép từ firestore.rules) =====
    match /progress/{id} {
        allow read: if true;
        allow create, update: if request.resource.size() < 8000;
        allow delete: if false;
      }
      match /requests/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['id', 'who', 'text', 'at']) && request.resource.size() < 2000;
        allow update, delete: if false;
      }
      // Cấu hình số lượng quà ở vòng quay (trang quản lý lưu, trang chị em đọc)
      match /settings/{id} {
        allow read: if true;
        allow write: if id == 'stock' && request.resource.data.keys().hasOnly(['qty', 'seed', 'map', 'at'])
          && request.resource.data.qty is list && request.resource.data.qty.size() <= 10
          && request.resource.data.map is map && request.resource.size() < 8000;
      }
      match /{document=**} { allow read, write: if false; }

  }
}
